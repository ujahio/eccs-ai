{
	"name": "eccs-ai",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.10",
	"scripts": {
		"dev": "bunx sst dev --stage localdev",
		"dev:e2e": "AUTH_E2E_MODE=memory bunx sst dev --stage localdev",
		"build": "bunx next build --webpack",
		"start": "bunx next start",
		"lint": "bunx eslint .",
		"typecheck": "bunx tsc --noEmit --incremental false",
		"test": "bunx vitest run",
		"test:e2e": "bunx playwright test",
		"test:e2e:memory": "AUTH_E2E_MODE=memory bunx playwright test",
		"test:e2e:local": "bun run test:e2e:memory",
		"cleanup:e2e-registrations": "bunx sst shell --stage localdev -- bun scripts/cleanup-e2e-registrations.ts",
		"sst:dev": "bun run dev",
		"sst:remove": "bunx sst remove --stage localdev"
	},
	"dependencies": {
		"@aws-sdk/client-cognito-identity-provider": "3.1076.0",
		"@aws-sdk/client-dynamodb": "3.1076.0",
		"@aws-sdk/lib-dynamodb": "3.1076.0",
		"@radix-ui/react-slot": "1.3.0",
		"aws-jwt-verify": "5.2.1",
		"better-auth": "1.6.11",
		"next": "16.2.9",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"resend": "6.16.0",
		"server-only": "0.0.1",
		"sst": "4.17.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.5",
		"@playwright/test": "1.61.1",
		"@tailwindcss/postcss": "4.3.2",
		"@types/node": "26.0.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"eslint": "9.39.4",
		"eslint-config-next": "16.2.9",
		"tailwindcss": "4.3.2",
		"typescript": "6.0.3",
		"vite": "8.1.0",
		"vitest": "4.1.9"
	}
}
