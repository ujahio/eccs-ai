{
	"name": "eccs-ai",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.10",
	"scripts": {
		"dev": "bunx sst dev --stage ailocal",
		"dev:e2e": "AUTH_E2E_MODE=memory bunx sst dev --stage ailocal",
		"build": "bunx next build --webpack",
		"start": "bunx next start",
		"lint": "bunx eslint .",
		"typecheck": "bunx tsc --noEmit --incremental false",
		"test": "bunx vitest run",
		"test:e2e": "bunx playwright test",
		"test:e2e:memory": "AUTH_E2E_MODE=memory bunx playwright test",
		"test:e2e:local": "bun run test:e2e:memory",
		"cleanup:e2e-registrations": "bunx sst shell --stage ailocal -- bun scripts/cleanup-e2e-registrations.ts",
		"sst:dev": "bun run dev",
		"sst:deploy:staging": "bunx sst deploy --stage staging",
		"sst:remove": "bunx sst remove --stage ailocal"
	},
	"dependencies": {
		"@aws-crypto/client-node": "5.0.0",
		"@aws-sdk/client-cognito-identity-provider": "3.1090.0",
		"@aws-sdk/client-dynamodb": "3.1090.0",
		"@aws-sdk/client-s3": "3.1090.0",
		"@aws-sdk/client-scheduler": "3.1090.0",
		"@aws-sdk/lib-dynamodb": "3.1090.0",
		"@aws-sdk/s3-request-presigner": "3.1090.0",
		"@radix-ui/react-dropdown-menu": "2.1.20",
		"aws-jwt-verify": "5.2.1",
		"better-auth": "1.6.23",
		"jsx-email": "3.2.1",
		"next": "16.2.10",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"resend": "6.17.2",
		"server-only": "0.0.1",
		"sharp": "0.34.5",
		"sst": "4.17.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"eslint": "9.39.5",
		"eslint-config-next": "16.2.10",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	},
	"overrides": {
		"react-router": "7.18.1",
		"react-router-dom": "7.18.1",
		"vite": "8.1.5"
	}
}
