{
  "name": "eccs-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bunx sst dev --stage local",
    "build": "bunx next build --webpack",
    "start": "bunx next start",
    "lint": "bunx eslint .",
    "typecheck": "bunx tsc --noEmit --incremental false",
    "test": "bunx vitest run",
    "test:e2e": "bunx playwright test",
    "sst:dev": "bun run dev",
    "sst:remove": "bunx sst remove --stage local"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1076.0",
    "@aws-sdk/client-dynamodb": "3.1076.0",
    "resend": "6.16.0",
    "@aws-sdk/lib-dynamodb": "3.1076.0",
    "@radix-ui/react-slot": "1.3.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sst": "4.17.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}
