# Sample environment variables for local development. Do not commit secrets to version control.
# Copy this file to .env.local and replace placeholder values locally.

# Better Auth local settings.
# Generate a local-only secret before running auth flows.
BETTER_AUTH_SECRET=replace-with-local-secret
BETTER_AUTH_URL=http://localhost:3001

NEXT_PUBLIC_APP_URL=http://localhost:3001
ECCS_EMAIL_SENDER="ECCS <no-reply@example.com>"
RESEND_API_KEY=replace-with-local-resend-api-key
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=us-east-2
AWS_SDK_LOAD_CONFIG=1

# Required when running Next.js without SST resource links, including Docker
# and future ECS task definitions. Local `bun run dev` gets these from
# `sst shell`; plain `bunx next dev` or `docker run --env-file .env.local`
# must provide them explicitly.
AUTH_USER_POOL_ID=replace-with-user-pool-id
AUTH_USER_POOL_CLIENT_ID=replace-with-user-pool-client-id
CASE_MATERIAL_BUCKET_NAME=replace-with-case-material-bucket-name
REGISTRATION_WORKFLOW_TABLE_NAME=replace-with-registration-workflow-table-name
USER_PROFILE_TABLE_NAME=replace-with-user-profile-table-name
TEACHER_CASE_TABLE_NAME=replace-with-teacher-case-table-name
STUDENT_CERTIFICATE_TABLE_NAME=replace-with-student-certificate-table-name
STUDENT_CASE_COMPLETION_TABLE_NAME=replace-with-student-case-completion-table-name
STUDENT_QUIZ_ATTEMPT_TABLE_NAME=replace-with-student-quiz-attempt-table-name
CASE_ARCHIVE_SCHEDULE_GROUP_NAME=default
CASE_ARCHIVE_SCHEDULE_NAME=replace-with-case-archive-schedule-name
CASE_ARCHIVE_SCHEDULER_ROLE_ARN=replace-with-case-archive-scheduler-role-arn
CASE_ARCHIVE_TARGET_ARN=replace-with-case-archive-target-arn

# GitHub Actions stage deployment.
# Configure these per GitHub Environment, for example `staging` and
# `production`; do not store real upper-stage values in local env files.
#
# GitHub Environment secrets:
# AWS_ROLE_ARN=..
# BETTER_AUTH_SECRET=replace-with-staging-secret
# RESEND_API_KEY=replace-with-staging-resend-api-key
#
# Do not configure AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in GitHub.
# GitHub Actions assumes AWS_ROLE_ARN through OIDC instead.
#
# GitHub Environment variables:
# AWS_REGION=me-central-1
# AWS_DEFAULT_REGION=me-central-1
# NEXT_PUBLIC_APP_URL=https://staging.example.com
# BETTER_AUTH_URL=https://staging.example.com
# ECCS_EMAIL_SENDER="ECCS <no-reply@example.com>"
