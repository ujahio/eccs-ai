# Sample environment variables for local development. Do not commit secrets to version control.
# Copy this file to .env.local and replace placeholder values locally.

# SST local stage for this workspace.
SST_STAGE=local

# Better Auth local settings.
# Generate a local-only secret before running auth flows.
BETTER_AUTH_SECRET=replace-with-local-secret
BETTER_AUTH_URL=http://localhost:3001

# Email testing uses MailSurp locally. Production email must be configured through
# SST-managed AWS SES resources only.
MAILSURP_API_KEY=replace-with-mailsurp-api-key
MAILSURP_INBOX_ID=replace-with-mailsurp-inbox-id

NEXT_PUBLIC_APP_URL=..
PUBLIC_DOMAIN=..
ECCS_EMAIL_SENDER=..
RESEND_API_KEY=..