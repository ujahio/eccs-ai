# Sample environment variables for local development. Do not commit secrets to version control.
# Copy this file to .env.local and replace placeholder values locally.

# Better Auth local settings.
# Generate a local-only secret before running auth flows.
BETTER_AUTH_SECRET=replace-with-local-secret
BETTER_AUTH_URL=..

NEXT_PUBLIC_APP_URL=..
ECCS_EMAIL_SENDER=..
RESEND_API_KEY=..
